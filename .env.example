# Copy to .env and fill in what you need. Every setting is optional.

# --- Language model (paraphraser, humaniser, optional second opinion on AI patterns) ---
# Any OpenAI-compatible endpoint. Examples:
#   OpenAI:          https://api.openai.com/v1
#   Ollama (compose): http://ollama:11434/v1      (local: http://localhost:11434/v1)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Let visitors use their own model from the Settings page. Keep false on public servers.
ALLOW_CLIENT_LLM=false
# Allow those browser-supplied URLs to point at localhost or private networks (e.g. their Ollama).
# Cloud metadata addresses are always refused.
ALLOW_PRIVATE_LLM=false

# --- Grammar ---
# A LanguageTool server. With the compose profile: http://languagetool:8010
# The public API (https://api.languagetool.org) works but sends text to a third party and is rate limited.
LANGUAGETOOL_URL=

# --- Scholarly APIs (free) ---
# Contact address for the Crossref and OpenAlex "polite pools" (faster, more reliable).
CONTACT_EMAIL=
# Free key from https://openalex.org (strongly recommended). Without it OpenAlex shares a small daily
# budget across everyone on your server's IP address and soon starts refusing requests.
OPENALEX_API_KEY=
# Optional key: higher Semantic Scholar rate limits and full-text snippet search for plagiarism checks.
SEMANTIC_SCHOLAR_API_KEY=

# --- Web search for plagiarism checks (optional, paid beyond free tiers) ---
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Local document library ---
# Folder of .txt/.md/.tex/.docx/.pdf files every plagiarism check also compares against.
# The compose file mounts ./library here.
LIBRARY_DIR=

# --- Outbound proxy ---
# If the server reaches the internet through an HTTP proxy (HTTPS_PROXY), Node needs this to use it.
# NODE_USE_ENV_PROXY=1

# --- Abuse protection ---
# Requests per minute per client for the cheapest routes; expensive routes get a fraction.
RATE_LIMIT_PER_MINUTE=30
# Read the client address from X-Forwarded-For. Only enable behind a reverse proxy you control;
# otherwise all clients share one rate-limit bucket.
TRUST_PROXY=false

# Port published by docker compose.
VERITOME_PORT=3000
